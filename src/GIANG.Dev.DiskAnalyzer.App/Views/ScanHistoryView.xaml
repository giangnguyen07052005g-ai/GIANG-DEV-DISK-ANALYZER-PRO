<UserControl x:Class="GIANG.Dev.DiskAnalyzer.App.Views.ScanHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="720" d:DesignWidth="1000">

    <Grid Margin="24,18,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="LỊCH SỬ PHÂN TÍCH Ổ ĐĨA (SCAN HISTORY - SQLITE)" 
                   FontSize="18" FontWeight="Bold" Foreground="{StaticResource BrushNeonCyan}" Margin="0,0,0,16" />

        <!-- Control Bar -->
        <Border Grid.Row="1" Background="{StaticResource BrushCard}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" Foreground="{StaticResource BrushNeonCyan}" VerticalAlignment="Center" />

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{StaticResource NeonSecondaryButton}" Command="{Binding LoadHistoryCommand}" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconRefresh}" Fill="{StaticResource BrushNeonCyan}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" />
                            <TextBlock Text="Làm mới" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource NeonSecondaryButton}" Command="{Binding ExportCsvCommand}" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconExport}" Fill="{StaticResource BrushNeonCyan}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" />
                            <TextBlock Text="Xuất CSV" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource NeonDangerButton}" Command="{Binding ClearAllCommand}">
                        <TextBlock Text="Xóa toàn bộ lịch sử" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- History DataGrid with Empty State -->
        <Border Grid.Row="2" Background="{StaticResource BrushPanel}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="14">
            <Grid>
                <DataGrid ItemsSource="{Binding HistoryEntries}" SelectedItem="{Binding SelectedEntry}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50" />
                        <DataGridTextColumn Header="LOẠI QUÉT" Binding="{Binding ScanTypeFormatted}" Width="160" />
                        <DataGridTextColumn Header="PHẠM VI" Binding="{Binding TargetPath}" Width="2*" />
                        <DataGridTextColumn Header="THỜI GIAN BẮT ĐẦU" Binding="{Binding StartTimeFormatted}" Width="140" />
                        <DataGridTextColumn Header="THỜI LƯỢNG" Binding="{Binding DurationFormatted}" Width="100" />
                        <DataGridTextColumn Header="SỐ FILE" Binding="{Binding TotalFiles, StringFormat={}{0:N0}}" Width="90" />
                        <DataGridTextColumn Header="TỔNG DUNG LƯỢNG" Binding="{Binding TotalSizeFormatted}" Width="120" />
                        <DataGridTextColumn Header="LỖI I/O" Binding="{Binding ErrorsCount}" Width="70" />
                        <DataGridTextColumn Header="GHI CHÚ" Binding="{Binding SummaryNotes}" Width="*" />
                    </DataGrid.Columns>
                    <DataGrid.ContextMenu>
                        <ContextMenu Background="{StaticResource BrushPanel}" Foreground="{StaticResource BrushTextPrimary}">
                            <MenuItem Header="Xóa bản ghi này" Command="{Binding DeleteEntryCommand}" CommandParameter="{Binding SelectedEntry}" />
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                </DataGrid>

                <!-- Empty State Overlay -->
                <Border Background="{StaticResource BrushPanel}"
                        Visibility="{Binding HistoryEntries.Count, Converter={StaticResource EmptyToVisibilityConverter}}"
                        IsHitTestVisible="False">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20">
                        <Path Data="{StaticResource IconHistory}" Fill="{StaticResource BrushBorderBright}" Width="48" Height="48" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,16" />
                        <TextBlock Text="CHƯA CÓ LỊCH SỬ PHÂN TÍCH" FontWeight="Bold" FontSize="15" Foreground="{StaticResource BrushTextSecondary}" HorizontalAlignment="Center" Margin="0,0,0,8" />
                        <TextBlock Text="Khi bạn thực hiện các phiên quét ổ đĩa, thông tin tóm tắt và nhật ký sẽ được lưu tự động tại đây." Foreground="{StaticResource BrushTextMuted}" HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="450" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
