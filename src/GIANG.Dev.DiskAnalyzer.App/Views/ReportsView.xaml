<UserControl x:Class="GIANG.Dev.DiskAnalyzer.App.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="720" d:DesignWidth="1000">

    <Grid Margin="24,18,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="XUẤT &amp; QUẢN LÝ BÁO CÁO PHÂN TÍCH (REPORTS)" 
                   FontSize="18" FontWeight="Bold" Foreground="{StaticResource BrushNeonCyan}" Margin="0,0,0,16" />

        <!-- Control Bar -->
        <Border Grid.Row="1" Background="{StaticResource BrushCard}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,14">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0" Text="{Binding ExportDirectory, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CyberTextBox}" Margin="0,0,10,0" VerticalAlignment="Center" />

                    <Button Grid.Column="1" Style="{StaticResource NeonSecondaryButton}" Command="{Binding BrowseExportDirectoryCommand}" Margin="0,0,10,0">
                        <TextBlock Text="Đổi thư mục lưu" />
                    </Button>

                    <Button Grid.Column="2" Style="{StaticResource NeonSecondaryButton}" Command="{Binding RefreshReportsCommand}" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconRefresh}" Fill="{StaticResource BrushNeonCyan}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" />
                            <TextBlock Text="Làm mới" />
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="3" Style="{StaticResource NeonPrimaryButton}" Command="{Binding GenerateHtmlReportCommand}" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconReports}" Fill="{StaticResource BrushNeonCyan}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0" />
                            <TextBlock Text="Tạo báo cáo HTML Cyberpunk" />
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="4" Style="{StaticResource NeonSecondaryButton}" Command="{Binding OpenReportsFolderCommand}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconOpenFolder}" Fill="{StaticResource BrushNeonCyan}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0" />
                            <TextBlock Text="Mở thư mục" />
                        </StackPanel>
                    </Button>
                </Grid>

                <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource BrushNeonCyan}" Margin="0,12,0,0" />
            </StackPanel>
        </Border>

        <!-- Generated Reports List -->
        <Border Grid.Row="2" Background="{StaticResource BrushPanel}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="CÁC BÁO CÁO ĐÃ XUẤT (NHẤP ĐỂ MỞ TRÊN TRÌNH DUYỆT / ỨNG DỤNG)" FontWeight="Bold" FontSize="13" Foreground="{StaticResource BrushNeonPurple}" Margin="0,0,0,12" />

                <Grid Grid.Row="1">
                    <ListBox ItemsSource="{Binding GeneratedReports}" SelectedItem="{Binding SelectedReportFile}" Background="Transparent" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1" Padding="8,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding}" Foreground="{StaticResource BrushTextPrimary}" FontWeight="SemiBold" />
                                        </StackPanel>
                                        <Button Grid.Column="1" 
                                                Style="{StaticResource NeonSecondaryButton}" 
                                                Command="{Binding DataContext.OpenReportCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                CommandParameter="{Binding}"
                                                Padding="10,4">
                                            <TextBlock Text="Mở file" />
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Empty State Overlay -->
                    <Border Background="{StaticResource BrushPanel}"
                            Visibility="{Binding GeneratedReports.Count, Converter={StaticResource EmptyToVisibilityConverter}}"
                            IsHitTestVisible="False">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20">
                            <Path Data="{StaticResource IconReports}" Fill="{StaticResource BrushBorderBright}" Width="48" Height="48" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,16" />
                            <TextBlock Text="CHƯA CÓ BÁO CÁO NÀO ĐƯỢC TẠO" FontWeight="Bold" FontSize="15" Foreground="{StaticResource BrushTextSecondary}" HorizontalAlignment="Center" Margin="0,0,0,8" />
                            <TextBlock Text="Nhấn 'Tạo báo cáo HTML Cyberpunk' ở trên để kết xuất trang báo cáo đồ họa chuyên nghiệp." Foreground="{StaticResource BrushTextMuted}" HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="450" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
