<UserControl x:Class="GIANG.Dev.DiskAnalyzer.App.Views.BigFileHunterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="720" d:DesignWidth="1000">

    <Grid Margin="24,18,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="SĂN TÌM FILE DUNG LƯỢNG LỚN (BIG FILE HUNTER)" 
                   FontSize="18" FontWeight="Bold" Foreground="{StaticResource BrushNeonAmber}" Margin="0,0,0,16" />

        <!-- Control Bar -->
        <Border Grid.Row="1" Background="{StaticResource BrushCard}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,14">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0" Text="{Binding TargetPath, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CyberTextBox}" Margin="0,0,10,0" VerticalAlignment="Center" />

                    <Button Grid.Column="1" Style="{StaticResource NeonSecondaryButton}" Command="{Binding BrowseFolderCommand}" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconOpenFolder}" Fill="{StaticResource BrushNeonCyan}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0" />
                            <TextBlock Text="Chọn phạm vi" />
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="2" Style="{StaticResource NeonPrimaryButton}" Command="{Binding StartHuntingCommand}" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconBigFiles}" Fill="{StaticResource BrushNeonCyan}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0" />
                            <TextBlock Text="Bắt đầu săn file" />
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="3" Style="{StaticResource NeonDangerButton}" Command="{Binding CancelHuntingCommand}" IsEnabled="{Binding IsHunting}">
                        <TextBlock Text="Hủy" />
                    </Button>
                </Grid>

                <!-- Threshold Selection -->
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Ngưỡng kích thước:" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center" Margin="0,0,12,0" />

                    <RadioButton Grid.Column="1" Content="> 100 MB" 
                                 IsChecked="{Binding SelectedThresholdIndex, Converter={StaticResource IntEqualsConverter}, ConverterParameter=0, Mode=TwoWay}" 
                                 GroupName="SizeThreshold" Foreground="{StaticResource BrushTextPrimary}" VerticalAlignment="Center" Margin="0,0,16,0" />
                    <RadioButton Grid.Column="2" Content="> 500 MB" 
                                 IsChecked="{Binding SelectedThresholdIndex, Converter={StaticResource IntEqualsConverter}, ConverterParameter=1, Mode=TwoWay}" 
                                 GroupName="SizeThreshold" Foreground="{StaticResource BrushTextPrimary}" VerticalAlignment="Center" Margin="0,0,16,0" />
                    <RadioButton Grid.Column="3" Content="> 1 GB" 
                                 IsChecked="{Binding SelectedThresholdIndex, Converter={StaticResource IntEqualsConverter}, ConverterParameter=2, Mode=TwoWay}" 
                                 GroupName="SizeThreshold" Foreground="{StaticResource BrushTextPrimary}" VerticalAlignment="Center" Margin="0,0,16,0" />
                    
                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                        <RadioButton Content="Tùy chỉnh (MB):" 
                                     IsChecked="{Binding SelectedThresholdIndex, Converter={StaticResource IntEqualsConverter}, ConverterParameter=3, Mode=TwoWay}" 
                                     GroupName="SizeThreshold" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox Text="{Binding CustomThresholdMb, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CyberTextBox}" Width="70" Padding="6,4" VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBlock Grid.Column="5" Text="{Binding StatusMessage}" Foreground="{StaticResource BrushNeonAmber}" HorizontalAlignment="Right" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- Progress Bar & Live Deletion Status Banner -->
        <Grid Grid.Row="2" Margin="0,0,0,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Dual Progress Bar: Indeterminate while hunting, percentage while deleting -->
            <ProgressBar Grid.Row="0" Style="{StaticResource CyberProgressBar}" 
                         IsIndeterminate="{Binding IsHunting}" 
                         Value="{Binding DeleteProgressPercent, Mode=OneWay}" 
                         Maximum="100" 
                         Height="4" Margin="0,0,0,6" />

            <!-- Live Deletion Active Indicator Banner -->
            <Border Grid.Row="1" Background="#231019" BorderBrush="{StaticResource BrushNeonRed}" BorderThickness="1" CornerRadius="6" Padding="12,7"
                    Visibility="{Binding IsDeleting, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Grid.Column="0">
                        <Path Data="{StaticResource IconTrash}" Fill="{StaticResource BrushNeonRed}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="ĐANG XÓA FILE LỚN:" FontWeight="Bold" FontSize="11.5" Foreground="{StaticResource BrushNeonRed}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding DeleteProgressStatus}" Foreground="{StaticResource BrushTextPrimary}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="2" Text="{Binding DeleteProgressPercent, StringFormat={}{0:N0}%}" FontWeight="Bold" Foreground="{StaticResource BrushNeonCyan}" FontSize="12.5" VerticalAlignment="Center" Margin="10,0,0,0" />
                </Grid>
            </Border>
        </Grid>

        <!-- Results Table -->
        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Filters & Batch Action Toolbar -->
            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Top Row: Filters & Quick Actions -->
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0" Text="{Binding SearchFilter, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CyberTextBox}" Margin="0,0,10,0" Tag="Lọc theo tên..." />

                    <TextBox Grid.Column="1" Text="{Binding ExtensionFilter, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CyberTextBox}" Margin="0,0,10,0" Tag="Đuôi (vd: .iso, .mp4)" />

                    <Button Grid.Column="2" Style="{StaticResource NeonSecondaryButton}" Command="{Binding CopyPathCommand}" CommandParameter="{Binding SelectedFile}" Margin="0,0,8,0">
                        <TextBlock Text="Sao chép đường dẫn" />
                    </Button>

                    <Button Grid.Column="3" Style="{StaticResource NeonSecondaryButton}" Command="{Binding ExportCsvCommand}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconExport}" Fill="{StaticResource BrushNeonAmber}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" />
                            <TextBlock Text="Xuất CSV" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Bottom Row: Batch Selection & Action Buttons -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Selection Buttons -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Button Style="{StaticResource NeonSecondaryButton}" Command="{Binding SelectAllCommand}" Margin="0,0,6,0" Padding="10,5">
                            <TextBlock Text="Chọn tất cả" />
                        </Button>
                        <Button Style="{StaticResource NeonSecondaryButton}" Command="{Binding DeselectAllCommand}" Margin="0,0,6,0" Padding="10,5">
                            <TextBlock Text="Bỏ chọn" />
                        </Button>
                        <Button Style="{StaticResource NeonSecondaryButton}" 
                                Command="{Binding MarkHighlightedCommand}" 
                                CommandParameter="{Binding ElementName=BigFilesDataGrid, Path=SelectedItems}" 
                                Margin="0,0,12,0" Padding="10,5"
                                ToolTip="Bôi đen nhiều dòng bằng chuột hoặc phím Shift/Ctrl rồi nhấn để chọn">
                            <TextBlock Text="Chọn mục bôi đen" />
                        </Button>
                    </StackPanel>

                    <!-- Selection Counter Badge -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Đã chọn: " Foreground="{StaticResource BrushTextSecondary}" FontSize="12" />
                        <TextBlock Text="{Binding SelectedFilesCount, StringFormat={}{0:N0} files}" FontWeight="Bold" Foreground="{StaticResource BrushNeonCyan}" FontSize="12" Margin="0,0,6,0" />
                        <TextBlock Text="{Binding SelectedFilesSizeFormatted, StringFormat={}({0})}" FontWeight="Bold" Foreground="{StaticResource BrushNeonGreen}" FontSize="12" />
                    </StackPanel>

                    <!-- Danger Action: Delete Selected -->
                    <Button Grid.Column="2" Style="{StaticResource NeonDangerButton}" 
                            Command="{Binding DeleteSelectedFilesCommand}" 
                            CommandParameter="{Binding ElementName=BigFilesDataGrid, Path=SelectedItems}" 
                            Padding="12,5"
                            ToolTip="Xóa các file lớn đã tích chọn hoặc các dòng đang bôi đen vào Thùng rác (phím tắt Delete)">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconTrash}" Fill="{StaticResource BrushNeonRed}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" />
                            <TextBlock Text="Xóa file đã chọn" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>

            <!-- Big Files DataGrid with Empty State -->
            <Grid Grid.Row="1">
                <DataGrid x:Name="BigFilesDataGrid" 
                          ItemsSource="{Binding BigFiles}" 
                          SelectedItem="{Binding SelectedFile}"
                          SelectionMode="Extended"
                          SelectionUnit="FullRow"
                          PreviewKeyDown="BigFilesDataGrid_PreviewKeyDown">
                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn Header="CHỌN" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="55" />
                        <DataGridTextColumn Header="TÊN FILE" Binding="{Binding FileName}" Width="2*" />
                        <DataGridTextColumn Header="ĐỊNH DẠNG" Binding="{Binding Extension}" Width="90" />
                        <DataGridTextColumn Header="DUNG LƯỢNG" Binding="{Binding SizeFormatted}" Width="130" />
                        <DataGridTextColumn Header="NGÀY CHỈNH SỬA" Binding="{Binding LastModifiedFormatted}" Width="140" />
                        <DataGridTextColumn Header="ĐƯỜNG DẪN ĐẦY ĐỦ" Binding="{Binding FullPath}" Width="3*" />
                    </DataGrid.Columns>
                    <DataGrid.ContextMenu>
                        <ContextMenu Background="{StaticResource BrushPanel}" Foreground="{StaticResource BrushTextPrimary}">
                            <MenuItem Header="✓ Đánh dấu chọn (các dòng bôi đen)" 
                                      Command="{Binding MarkHighlightedCommand}" 
                                      CommandParameter="{Binding ElementName=BigFilesDataGrid, Path=SelectedItems}" />
                            <MenuItem Header="✗ Bỏ đánh dấu chọn (các dòng bôi đen)" 
                                      Command="{Binding UnmarkHighlightedCommand}" 
                                      CommandParameter="{Binding ElementName=BigFilesDataGrid, Path=SelectedItems}" />
                            <Separator Background="{StaticResource BrushBorder}" />
                            <MenuItem Header="Mở vị trí trong File Explorer" Command="{Binding OpenInExplorerCommand}" CommandParameter="{Binding SelectedFile}" />
                            <MenuItem Header="Sao chép đường dẫn" Command="{Binding CopyPathCommand}" CommandParameter="{Binding SelectedFile}" />
                            <Separator Background="{StaticResource BrushBorder}" />
                            <MenuItem Header="Chuyển vào Thùng rác (các file đã chọn / bôi đen)" 
                                      Command="{Binding DeleteSelectedFilesCommand}" 
                                      CommandParameter="{Binding ElementName=BigFilesDataGrid, Path=SelectedItems}" 
                                      Foreground="{StaticResource BrushNeonRed}" />
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                </DataGrid>

                <!-- Empty State Overlay -->
                <Border Background="{StaticResource BrushPanel}"
                        Visibility="{Binding BigFiles.Count, Converter={StaticResource EmptyToVisibilityConverter}}"
                        IsHitTestVisible="False">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20">
                        <Path Data="{StaticResource IconBigFiles}" Fill="{StaticResource BrushBorderBright}" Width="48" Height="48" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,16" />
                        <TextBlock Text="CHƯA CÓ FILE LỚN ĐƯỢC TÌM THẤY" FontWeight="Bold" FontSize="15" Foreground="{StaticResource BrushTextSecondary}" HorizontalAlignment="Center" Margin="0,0,0,8" />
                        <TextBlock Text="Chọn phạm vi tìm kiếm, chọn ngưỡng dung lượng và nhấn 'Bắt đầu săn file'." Foreground="{StaticResource BrushTextMuted}" HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="400" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
