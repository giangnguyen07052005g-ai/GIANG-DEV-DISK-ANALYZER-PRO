<UserControl x:Class="GIANG.Dev.DiskAnalyzer.App.Views.StorageScanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="720" d:DesignWidth="1000">

    <Grid Margin="24,18,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="PHÂN TÍCH DUNG LƯỢNG LƯU TRỮ (SMART STORAGE SCAN)" 
                   FontSize="18" FontWeight="Bold" Foreground="{StaticResource BrushNeonCyan}" Margin="0,0,0,16" />

        <!-- Control Bar -->
        <Border Grid.Row="1" Background="{StaticResource BrushCard}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Row 1: Target path & buttons -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0" Text="{Binding TargetPath, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CyberTextBox}" Margin="0,0,10,0" VerticalAlignment="Center" />

                    <Button Grid.Column="1" Style="{StaticResource NeonSecondaryButton}" Command="{Binding BrowseFolderCommand}" Margin="0,0,10,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconOpenFolder}" Fill="{StaticResource BrushNeonCyan}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0" />
                            <TextBlock Text="Chọn thư mục" />
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="2" 
                            Style="{StaticResource NeonPrimaryButton}" 
                            Command="{Binding StartScanCommand}" 
                            IsEnabled="{Binding IsNotScanning}"
                            Margin="0,0,8,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconPlay}" Fill="{StaticResource BrushNeonCyan}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" />
                            <TextBlock Text="Bắt đầu quét" />
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="3" 
                            Style="{StaticResource NeonSecondaryButton}" 
                            Command="{Binding TogglePauseCommand}" 
                            IsEnabled="{Binding IsScanning}" 
                            Margin="0,0,8,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconPause}" Fill="{StaticResource BrushNeonCyan}" Width="11" Height="11" Stretch="Uniform" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding PauseResumeText}" />
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="4" 
                            Style="{StaticResource NeonDangerButton}" 
                            Command="{Binding CancelScanCommand}" 
                            IsEnabled="{Binding IsScanning}" 
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconStop}" Fill="{StaticResource BrushNeonRed}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" />
                            <TextBlock Text="Hủy quét" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Row 2: Options & Status -->
                <Grid Grid.Row="1" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <CheckBox Grid.Column="0" Content="Quét thư mục con (Đệ quy)" IsChecked="{Binding IncludeSubdirectories}" Style="{StaticResource CyberCheckBox}" VerticalAlignment="Center" />

                    <TextBlock Grid.Column="1" Text="{Binding StatusMessage}" Foreground="{StaticResource BrushNeonCyan}" Margin="20,0,10,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding FilesScanned, StringFormat={}Số file: {0:N0}}" Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,16,0" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding TotalSizeScanned, StringFormat={}Dung lượng: {0}}" Foreground="{StaticResource BrushNeonCyan}" Margin="0,0,16,0" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding ElapsedTime, StringFormat={}Thời gian: {0}}" Foreground="{StaticResource BrushNeonPurple}" FontWeight="SemiBold" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- Progress Bar & Live Deletion Status Banner -->
        <Grid Grid.Row="2" Margin="0,0,0,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Dual Progress Bar: Indeterminate while scanning, percentage while deleting -->
            <ProgressBar Grid.Row="0" Style="{StaticResource CyberProgressBar}" 
                         IsIndeterminate="{Binding IsScanning}" 
                         Value="{Binding DeleteProgressPercent, Mode=OneWay}" 
                         Maximum="100" 
                         Height="4" Margin="0,0,0,6" />

            <!-- Live Deletion Active Indicator Banner -->
            <Border Grid.Row="1" Background="#231019" BorderBrush="{StaticResource BrushNeonRed}" BorderThickness="1" CornerRadius="6" Padding="12,7"
                    Visibility="{Binding IsDeleting, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Grid.Column="0">
                        <Path Data="{StaticResource IconTrash}" Fill="{StaticResource BrushNeonRed}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="ĐANG XÓA FILE:" FontWeight="Bold" FontSize="11.5" Foreground="{StaticResource BrushNeonRed}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding DeleteProgressStatus}" Foreground="{StaticResource BrushTextPrimary}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="2" Text="{Binding DeleteProgressPercent, StringFormat={}{0:N0}%}" FontWeight="Bold" Foreground="{StaticResource BrushNeonCyan}" FontSize="12.5" VerticalAlignment="Center" Margin="10,0,0,0" />
                </Grid>
            </Border>
        </Grid>

        <!-- Main Content Area: Split Top Folders & Files DataGrid -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left: Top Largest Folders -->
            <Border Grid.Column="0" Background="{StaticResource BrushPanel}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="THƯ MỤC LỚN NHẤT" FontWeight="Bold" FontSize="13" Foreground="{StaticResource BrushNeonPurple}" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Style="{StaticResource NeonSecondaryButton}" Command="{Binding ClearTopFolderFilterCommand}" Padding="6,2" FontSize="11" ToolTip="Hiển thị tất cả thư mục">
                            <TextBlock Text="Bỏ lọc" />
                        </Button>
                    </Grid>

                    <ListBox Grid.Row="1" ItemsSource="{Binding TopFolders}" SelectedItem="{Binding SelectedTopFolder}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1" Padding="4,8">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" TextTrimming="CharacterEllipsis" />
                                        <Grid Margin="0,4,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding SizeFormatted}" Foreground="{StaticResource BrushNeonCyan}" FontSize="11.5" />
                                            <TextBlock Grid.Column="1" Text="{Binding FileCount, StringFormat={}{0:N0} files}" Foreground="{StaticResource BrushTextMuted}" FontSize="11" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent" />

            <!-- Right: Search & DataGrid -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Filter & Action Controls -->
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Top Row: Search & Filter -->
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0" Text="{Binding SearchFilter, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CyberTextBox}" Margin="0,0,10,0" Tag="Tìm kiếm theo tên file..." />

                        <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableExtensions}" SelectedItem="{Binding SelectedExtension}" Background="{StaticResource BrushPanel}" Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,10,0" VerticalAlignment="Center" Height="34" />

                        <Button Grid.Column="2" Style="{StaticResource NeonSecondaryButton}" Command="{Binding CopyPathCommand}" CommandParameter="{Binding SelectedFile}" Margin="0,0,8,0">
                            <TextBlock Text="Sao chép đường dẫn" />
                        </Button>

                        <Button Grid.Column="3" Style="{StaticResource NeonSecondaryButton}" Command="{Binding ExportCsvCommand}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconExport}" Fill="{StaticResource BrushNeonCyan}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" />
                                <TextBlock Text="Xuất CSV" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Bottom Row: Batch Selection & Action Buttons -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Selection Buttons -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <Button Style="{StaticResource NeonSecondaryButton}" Command="{Binding SelectAllCommand}" Margin="0,0,6,0" Padding="10,5">
                                <TextBlock Text="Chọn tất cả" />
                            </Button>
                            <Button Style="{StaticResource NeonSecondaryButton}" Command="{Binding DeselectAllCommand}" Margin="0,0,6,0" Padding="10,5">
                                <TextBlock Text="Bỏ chọn" />
                            </Button>
                            <Button Style="{StaticResource NeonSecondaryButton}" 
                                    Command="{Binding MarkHighlightedCommand}" 
                                    CommandParameter="{Binding ElementName=FilesDataGrid, Path=SelectedItems}" 
                                    Margin="0,0,12,0" Padding="10,5"
                                    ToolTip="Bôi đen nhiều dòng bằng chuột hoặc phím Shift/Ctrl rồi nhấn để chọn">
                                <TextBlock Text="Chọn mục bôi đen" />
                            </Button>
                        </StackPanel>

                        <!-- Selection Counter Badge -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Đã chọn: " Foreground="{StaticResource BrushTextSecondary}" FontSize="12" />
                            <TextBlock Text="{Binding SelectedFilesCount, StringFormat={}{0:N0} files}" FontWeight="Bold" Foreground="{StaticResource BrushNeonCyan}" FontSize="12" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding SelectedFilesSizeFormatted, StringFormat={}({0})}" FontWeight="Bold" Foreground="{StaticResource BrushNeonGreen}" FontSize="12" />
                        </StackPanel>

                        <!-- Danger Action: Delete Selected -->
                        <Button Grid.Column="2" Style="{StaticResource NeonDangerButton}" 
                                Command="{Binding DeleteSelectedFilesCommand}" 
                                CommandParameter="{Binding ElementName=FilesDataGrid, Path=SelectedItems}" 
                                Padding="12,5"
                                ToolTip="Xóa các file đã tích chọn hoặc các dòng đang bôi đen vào Thùng rác (phím tắt Delete)">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconTrash}" Fill="{StaticResource BrushNeonRed}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" />
                                <TextBlock Text="Xóa file đã chọn" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>

                <!-- Files Virtualized DataGrid with Empty State -->
                <Grid Grid.Row="1">
                    <DataGrid x:Name="FilesDataGrid" 
                              ItemsSource="{Binding DisplayedFiles}" 
                              SelectedItem="{Binding SelectedFile}"
                              SelectionMode="Extended"
                              SelectionUnit="FullRow"
                              PreviewKeyDown="FilesDataGrid_PreviewKeyDown">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="CHỌN" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="55" />
                            <DataGridTextColumn Header="TÊN FILE" Binding="{Binding FileName}" Width="2*" />
                            <DataGridTextColumn Header="ĐUÔI" Binding="{Binding Extension}" Width="60" />
                            <DataGridTextColumn Header="DUNG LƯỢNG" Binding="{Binding SizeFormatted}" Width="110" />
                            <DataGridTextColumn Header="NGÀY CHỈNH SỬA" Binding="{Binding LastModifiedFormatted}" Width="140" />
                            <DataGridTextColumn Header="THƯ MỤC CHỨA" Binding="{Binding DirectoryPath}" Width="3*" />
                        </DataGrid.Columns>
                        <DataGrid.ContextMenu>
                            <ContextMenu Background="{StaticResource BrushPanel}" Foreground="{StaticResource BrushTextPrimary}">
                                <MenuItem Header="✓ Đánh dấu chọn (các dòng bôi đen)" 
                                          Command="{Binding MarkHighlightedCommand}" 
                                          CommandParameter="{Binding ElementName=FilesDataGrid, Path=SelectedItems}" />
                                <MenuItem Header="✗ Bỏ đánh dấu chọn (các dòng bôi đen)" 
                                          Command="{Binding UnmarkHighlightedCommand}" 
                                          CommandParameter="{Binding ElementName=FilesDataGrid, Path=SelectedItems}" />
                                <Separator Background="{StaticResource BrushBorder}" />
                                <MenuItem Header="Mở vị trí trong File Explorer" Command="{Binding OpenInExplorerCommand}" CommandParameter="{Binding SelectedFile}" />
                                <MenuItem Header="Sao chép đường dẫn file" Command="{Binding CopyPathCommand}" CommandParameter="{Binding SelectedFile}" />
                                <Separator Background="{StaticResource BrushBorder}" />
                                <MenuItem Header="Chuyển vào Thùng rác (các file đã chọn / bôi đen)" 
                                          Command="{Binding DeleteSelectedFilesCommand}" 
                                          CommandParameter="{Binding ElementName=FilesDataGrid, Path=SelectedItems}" 
                                          Foreground="{StaticResource BrushNeonRed}" />
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                    </DataGrid>

                    <!-- Empty State Overlay -->
                    <Border Background="{StaticResource BrushPanel}"
                            Visibility="{Binding DisplayedFiles.Count, Converter={StaticResource EmptyToVisibilityConverter}}"
                            IsHitTestVisible="False">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20">
                            <Path Data="{StaticResource IconScan}" Fill="{StaticResource BrushBorderBright}" Width="48" Height="48" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,16" />
                            <TextBlock Text="CHƯA CÓ KẾT QUẢ PHÂN TÍCH" FontWeight="Bold" FontSize="15" Foreground="{StaticResource BrushTextSecondary}" HorizontalAlignment="Center" Margin="0,0,0,8" />
                            <TextBlock Text="Chọn ổ đĩa hoặc thư mục phía trên rồi nhấn 'Bắt đầu quét' để phân tích chi tiết." Foreground="{StaticResource BrushTextMuted}" HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="400" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
