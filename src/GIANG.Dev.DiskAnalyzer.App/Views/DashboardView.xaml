<UserControl x:Class="GIANG.Dev.DiskAnalyzer.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:components="clr-namespace:GIANG.Dev.DiskAnalyzer.App.Views.Components"
             mc:Ignorable="d" 
             d:DesignHeight="720" d:DesignWidth="1000">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,20,28,30">

            <!-- Top Header & Refresh -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <components:GiangDevLogo Width="42" Height="42" Margin="0,0,16,0" VerticalAlignment="Center" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="BẢNG ĐIỀU KHIỂN HỆ THỐNG" FontSize="20" FontWeight="Bold" Foreground="{StaticResource BrushNeonCyan}" />
                        <TextBlock Text="GIANG DEV DISK ANALYZER PRO • Tổng quan dung lượng thực tế và trạng thái các ổ đĩa" 
                                   Foreground="{StaticResource BrushTextSecondary}" Margin="0,3,0,0" FontSize="12.5" />
                    </StackPanel>
                </StackPanel>

                <Button Grid.Column="1" 
                        Style="{StaticResource NeonSecondaryButton}"
                        Command="{Binding RefreshDrivesCommand}"
                        Padding="14,8">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconRefresh}" Fill="{StaticResource BrushNeonCyan}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" />
                        <TextBlock Text="Làm mới ổ đĩa" VerticalAlignment="Center" Foreground="{StaticResource BrushTextPrimary}" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- 4 Quick Stat Cards -->
            <Grid Margin="0,0,0,26">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Total Space Card -->
                <Border Grid.Column="0" Background="{StaticResource BrushCard}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="TỔNG DUNG LƯỢNG" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushTextMuted}" />
                        <TextBlock Text="{Binding TotalStorageFormatted}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" Margin="0,8,0,0" />
                        <TextBlock Text="Tất cả ổ đĩa khả dụng" FontSize="11.5" Foreground="{StaticResource BrushTextSecondary}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <!-- Used Space Card -->
                <Border Grid.Column="1" Background="{StaticResource BrushCard}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="18" Margin="5,0,5,0">
                    <StackPanel>
                        <TextBlock Text="ĐÃ SỬ DỤNG" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushTextMuted}" />
                        <TextBlock Text="{Binding TotalUsedFormatted}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource BrushNeonCyan}" Margin="0,8,0,0" />
                        <TextBlock Text="{Binding OverallUsedPercentage, StringFormat={}{0:F1}% tổng lưu trữ}" FontSize="11.5" Foreground="{StaticResource BrushNeonCyan}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <!-- Free Space Card -->
                <Border Grid.Column="2" Background="{StaticResource BrushCard}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="18" Margin="5,0,5,0">
                    <StackPanel>
                        <TextBlock Text="CÒN TRỐNG" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushTextMuted}" />
                        <TextBlock Text="{Binding TotalFreeFormatted}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource BrushNeonGreen}" Margin="0,8,0,0" />
                        <TextBlock Text="Khả dụng cho lưu trữ mới" FontSize="11.5" Foreground="{StaticResource BrushNeonGreen}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <!-- Session Activity Card -->
                <Border Grid.Column="3" Background="{StaticResource BrushCard}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="18" Margin="10,0,0,0">
                    <StackPanel>
                        <TextBlock Text="FILE ĐÃ QUÉT PHIÊN NÀY" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushTextMuted}" />
                        <TextBlock Text="{Binding TotalFilesScannedSession, StringFormat={}{0:N0}}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource BrushNeonPurple}" Margin="0,8,0,0" />
                        <TextBlock Text="{Binding LastScanTime}" FontSize="11.5" Foreground="{StaticResource BrushTextSecondary}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Real Drives Section -->
            <TextBlock Text="DANH SÁCH Ổ ĐĨA HỆ THỐNG THỰC TẾ" FontSize="15" FontWeight="Bold" Foreground="{StaticResource BrushNeonCyan}" Margin="0,0,0,12" />

            <ItemsControl ItemsSource="{Binding Drives}" Margin="0,0,0,24">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource BrushCard}" 
                                BorderBrush="{StaticResource BrushBorder}" 
                                BorderThickness="1" 
                                CornerRadius="8" 
                                Padding="18" 
                                Width="290" 
                                Margin="0,0,16,16">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="BorderBrush" Value="{StaticResource BrushNeonCyan}" />
                                            <Setter Property="Background" Value="{StaticResource BrushCardHover}" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding DisplayTitle}" FontWeight="Bold" FontSize="16" Foreground="{StaticResource BrushTextPrimary}" />
                                        <TextBlock Text="{Binding DriveType, StringFormat={}Loại: {0}}" FontSize="11.5" Foreground="{StaticResource BrushTextSecondary}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="#162A45" CornerRadius="4" Padding="6,2" VerticalAlignment="Top">
                                        <TextBlock Text="{Binding DriveFormat}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushNeonCyan}" />
                                    </Border>
                                </Grid>

                                <!-- Storage Bar -->
                                <Grid Margin="0,14,0,6">
                                    <ProgressBar Style="{StaticResource CyberProgressBar}" Value="{Binding UsedPercentage, Mode=OneWay}" Height="10" />
                                </Grid>

                                <Grid Margin="0,4,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding UsedFormatted, StringFormat={}Đã dùng: {0}}" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" />
                                    <TextBlock Grid.Column="1" Text="{Binding UsedPercentage, StringFormat={}{0:F1}%}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushNeonCyan}" />
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding FreeFormatted, StringFormat={}Còn trống: {0}}" FontSize="12" Foreground="{StaticResource BrushNeonGreen}" VerticalAlignment="Center" />

                                    <Button Grid.Column="1" 
                                            Style="{StaticResource NeonPrimaryButton}"
                                            Command="{Binding DataContext.ScanDriveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Padding="12,5"
                                            FontSize="12">
                                        <TextBlock Text="Phân tích" />
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Quick Action Shortcuts -->
            <TextBlock Text="LỐI TẮT TÁC VỤ NHANH" FontSize="15" FontWeight="Bold" Foreground="{StaticResource BrushNeonPurple}" Margin="0,6,0,12" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Style="{StaticResource NeonSecondaryButton}" Command="{Binding QuickActionCommand}" CommandParameter="StorageScan" Margin="0,0,10,0" Padding="14,12">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconScan}" Fill="{StaticResource BrushNeonCyan}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,10,0" />
                        <TextBlock Text="Quét toàn diện" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Grid.Column="1" Style="{StaticResource NeonSecondaryButton}" Command="{Binding QuickActionCommand}" CommandParameter="BigFiles" Margin="5,0,5,0" Padding="14,12">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconBigFiles}" Fill="{StaticResource BrushNeonAmber}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,10,0" />
                        <TextBlock Text="Săn file lớn >100MB" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Grid.Column="2" Style="{StaticResource NeonSecondaryButton}" Command="{Binding QuickActionCommand}" CommandParameter="Duplicates" Margin="5,0,5,0" Padding="14,12">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconDuplicate}" Fill="{StaticResource BrushNeonPurple}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,10,0" />
                        <TextBlock Text="Tìm file trùng SHA-256" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Grid.Column="3" Style="{StaticResource NeonSecondaryButton}" Command="{Binding QuickActionCommand}" CommandParameter="SafeCleanup" Margin="10,0,0,0" Padding="14,12">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconSafeCleanup}" Fill="{StaticResource BrushNeonGreen}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,10,0" />
                        <TextBlock Text="Dọn dẹp Temp &amp; Cache" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>
