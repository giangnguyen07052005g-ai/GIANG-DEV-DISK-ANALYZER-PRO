<UserControl x:Class="GIANG.Dev.DiskAnalyzer.App.Views.DuplicateFinderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="720" d:DesignWidth="1000">

    <Grid Margin="24,18,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="TÌM KIẾM FILE TRÙNG LẶP NỘI DUNG (SHA-256 DUPLICATE FINDER)" 
                   FontSize="18" FontWeight="Bold" Foreground="{StaticResource BrushNeonPurple}" Margin="0,0,0,16" />

        <!-- Control Bar -->
        <Border Grid.Row="1" Background="{StaticResource BrushCard}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,14">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0" Text="{Binding TargetPath, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CyberTextBox}" Margin="0,0,10,0" VerticalAlignment="Center" />

                    <Button Grid.Column="1" Style="{StaticResource NeonSecondaryButton}" Command="{Binding BrowseFolderCommand}" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconOpenFolder}" Fill="{StaticResource BrushNeonCyan}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0" />
                            <TextBlock Text="Chọn thư mục" />
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="2" Style="{StaticResource NeonPrimaryButton}" Command="{Binding StartSearchCommand}" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconDuplicate}" Fill="{StaticResource BrushNeonCyan}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0" />
                            <TextBlock Text="Quét trùng lặp" />
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="3" Style="{StaticResource NeonDangerButton}" Command="{Binding CancelSearchCommand}" IsEnabled="{Binding IsScanning}">
                        <TextBlock Text="Hủy" />
                    </Button>
                </Grid>

                <!-- Status & Action Bar -->
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource BrushNeonCyan}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <TextBlock Text="Tiết kiệm tiềm năng:" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="{Binding TotalPotentialSavingsFormatted}" FontWeight="Bold" FontSize="15" Foreground="{StaticResource BrushNeonGreen}" VerticalAlignment="Center" Margin="0,0,20,0" />

                        <Button Style="{StaticResource NeonSecondaryButton}" Command="{Binding KeepOldestCommand}" Margin="0,0,8,0" Padding="10,6">
                            <TextBlock Text="Giữ file cũ nhất" />
                        </Button>
                        <Button Style="{StaticResource NeonSecondaryButton}" Command="{Binding KeepNewestCommand}" Margin="0,0,8,0" Padding="10,6">
                            <TextBlock Text="Giữ file mới nhất" />
                        </Button>
                        <Button Style="{StaticResource NeonSecondaryButton}" Command="{Binding ClearSelectionCommand}" Margin="0,0,12,0" Padding="10,6">
                            <TextBlock Text="Bỏ chọn hết" />
                        </Button>

                        <Button Style="{StaticResource NeonDangerButton}" Command="{Binding DeleteSelectedDuplicatesCommand}" Padding="14,6">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconTrash}" Fill="{StaticResource BrushNeonRed}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0" />
                                <TextBlock Text="Xóa bản sao đã chọn" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Progress Bar -->
        <ProgressBar Grid.Row="2" Style="{StaticResource CyberProgressBar}" Value="{Binding ProgressPercent, Mode=OneWay}" Height="4" Margin="0,0,0,14" />

        <!-- Master-Detail Content: Groups & Files -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Duplicate Groups List with Empty State -->
            <Border Grid.Column="0" Background="{StaticResource BrushPanel}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="{Binding DuplicateGroups.Count, StringFormat={}CÁC NHÓM TRÙNG LẶP ({0})}" FontWeight="Bold" FontSize="13" Foreground="{StaticResource BrushNeonPurple}" Margin="0,0,0,10" />

                    <Grid Grid.Row="1">
                        <ListBox ItemsSource="{Binding DuplicateGroups}" SelectedItem="{Binding SelectedGroup}" Background="Transparent" BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1" Padding="6,8">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding SizeFormatted, StringFormat={}Kích thước: {0}}" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" />
                                                <TextBlock Grid.Column="1" Text="{Binding FileCount, StringFormat={}{0} bản sao}" Foreground="{StaticResource BrushNeonCyan}" FontWeight="SemiBold" />
                                            </Grid>
                                            <Grid Margin="0,4,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding ContentHash, StringFormat={}Hash: {0}}" Foreground="{StaticResource BrushTextMuted}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="1" Text="{Binding WastedFormatted, StringFormat={}Tiết kiệm: {0}}" Foreground="{StaticResource BrushNeonGreen}" FontSize="11" FontWeight="SemiBold" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Empty State Overlay for Groups -->
                        <Border Background="{StaticResource BrushPanel}"
                                Visibility="{Binding DuplicateGroups.Count, Converter={StaticResource EmptyToVisibilityConverter}}"
                                IsHitTestVisible="False">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="14">
                                <Path Data="{StaticResource IconDuplicate}" Fill="{StaticResource BrushBorderBright}" Width="36" Height="36" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,12" />
                                <TextBlock Text="CHƯA CÓ DỮ LIỆU" FontWeight="Bold" FontSize="13" Foreground="{StaticResource BrushTextSecondary}" HorizontalAlignment="Center" Margin="0,0,0,6" />
                                <TextBlock Text="Nhấn 'Quét trùng lặp' để tìm kiếm file trùng nội dung." Foreground="{StaticResource BrushTextMuted}" FontSize="11.5" HorizontalAlignment="Center" TextAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent" />

            <!-- Selected Group Detail Files List with Empty State -->
            <Border Grid.Column="2" Background="{StaticResource BrushPanel}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="CHI TIẾT CÁC BẢN SAO TRONG NHÓM (CHỌN BẢN CẦN XÓA)" FontWeight="Bold" FontSize="13" Foreground="{StaticResource BrushNeonCyan}" VerticalAlignment="Center" />

                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Style="{StaticResource NeonSecondaryButton}" Command="{Binding SelectAllInGroupCommand}" Margin="0,0,6,0" Padding="8,4" FontSize="11" ToolTip="Chọn tất cả bản sao trong nhóm này (tự động giữ lại 1 bản an toàn)">
                                <TextBlock Text="Chọn bản sao (giữ 1)" />
                            </Button>
                            <Button Style="{StaticResource NeonSecondaryButton}" Command="{Binding DeselectInGroupCommand}" Margin="0,0,6,0" Padding="8,4" FontSize="11">
                                <TextBlock Text="Bỏ chọn" />
                            </Button>
                            <Button Style="{StaticResource NeonSecondaryButton}" 
                                    Command="{Binding MarkHighlightedCommand}" 
                                    CommandParameter="{Binding ElementName=DuplicatesDataGrid, Path=SelectedItems}" 
                                    Padding="8,4" FontSize="11"
                                    ToolTip="Bôi đen các dòng bằng chuột hoặc Shift/Ctrl rồi nhấn để đánh dấu chọn">
                                <TextBlock Text="Chọn mục bôi đen" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1">
                        <DataGrid x:Name="DuplicatesDataGrid" 
                                  ItemsSource="{Binding SelectedGroup.Files}"
                                  SelectionMode="Extended"
                                  SelectionUnit="FullRow"
                                  PreviewKeyDown="DuplicatesDataGrid_PreviewKeyDown">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Header="XÓA" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="55" />
                                <DataGridTextColumn Header="TÊN FILE" Binding="{Binding FileName}" Width="180" />
                                <DataGridTextColumn Header="NGÀY CHỈNH SỬA" Binding="{Binding LastModifiedFormatted}" Width="140" />
                                <DataGridTextColumn Header="ĐƯỜNG DẪN ĐẦY ĐỦ" Binding="{Binding FullPath}" Width="*" />
                            </DataGrid.Columns>
                            <DataGrid.ContextMenu>
                                <ContextMenu Background="{StaticResource BrushPanel}" Foreground="{StaticResource BrushTextPrimary}">
                                    <MenuItem Header="✓ Đánh dấu chọn xóa (các dòng bôi đen)" 
                                              Command="{Binding MarkHighlightedCommand}" 
                                              CommandParameter="{Binding ElementName=DuplicatesDataGrid, Path=SelectedItems}" />
                                    <MenuItem Header="✗ Bỏ đánh dấu chọn (các dòng bôi đen)" 
                                              Command="{Binding UnmarkHighlightedCommand}" 
                                              CommandParameter="{Binding ElementName=DuplicatesDataGrid, Path=SelectedItems}" />
                                    <Separator Background="{StaticResource BrushBorder}" />
                                    <MenuItem Header="Mở vị trí trong File Explorer" Command="{Binding OpenInExplorerCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=ContextMenu}, Path=PlacementTarget.SelectedItem}" />
                                    <Separator Background="{StaticResource BrushBorder}" />
                                    <MenuItem Header="Chuyển vào Thùng rác (các bản sao đã chọn)" 
                                              Command="{Binding DeleteSelectedDuplicatesCommand}" 
                                              CommandParameter="{Binding ElementName=DuplicatesDataGrid, Path=SelectedItems}" 
                                              Foreground="{StaticResource BrushNeonRed}" />
                                </ContextMenu>
                            </DataGrid.ContextMenu>
                        </DataGrid>

                        <!-- Empty State Overlay for Selected Group -->
                        <Border Background="{StaticResource BrushPanel}"
                                Visibility="{Binding SelectedGroup.Files.Count, Converter={StaticResource EmptyToVisibilityConverter}}"
                                IsHitTestVisible="False">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20">
                                <TextBlock Text="CHƯA CHỌN NHÓM TRÙNG LẶP NÀO" FontWeight="Bold" FontSize="14" Foreground="{StaticResource BrushTextSecondary}" HorizontalAlignment="Center" Margin="0,0,0,6" />
                                <TextBlock Text="Nhấp vào một nhóm ở cột bên trái để xem và đánh dấu các file cần xóa an toàn." Foreground="{StaticResource BrushTextMuted}" HorizontalAlignment="Center" TextAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
