<UserControl x:Class="GIANG.Dev.DiskAnalyzer.App.Views.UpdateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:viewmodels="clr-namespace:GIANG.Dev.DiskAnalyzer.App.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=viewmodels:UpdateViewModel}"
             d:DesignHeight="700" d:DesignWidth="1000"
             Background="{StaticResource BrushBgDark}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/GIANG.Dev.DiskAnalyzer.App;component/Themes/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <!-- Header -->
            <RowDefinition Height="Auto" />
            <!-- KPI Summary Cards -->
            <RowDefinition Height="Auto" />
            <!-- Content & Actions -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 1. Header -->
        <Border Grid.Row="0" Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Border Background="#132338" BorderBrush="{StaticResource BrushNeonCyan}" BorderThickness="1" CornerRadius="6" Width="36" Height="36" Margin="0,0,12,0">
                            <Path Data="{StaticResource IconUpdate}" Fill="{StaticResource BrushNeonCyan}" Width="18" Height="18" Stretch="Uniform" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="CẬP NHẬT PHẦN MỀM" FontSize="18" FontWeight="Black" Foreground="{StaticResource BrushNeonCyan}" />
                            <TextBlock Text="Hệ thống kiểm tra phiên bản từ xa, xác minh chữ ký số mật mã học và cài đặt an toàn từ GitHub Releases" 
                                       FontSize="12" Foreground="{StaticResource BrushTextSecondary}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- Check Update Quick Button in Header -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource CyberButtonSecondary}" Command="{Binding CheckForUpdatesCommand}" IsEnabled="{Binding IsChecking, Converter={StaticResource InverseBoolToVisibilityConverter}, Mode=OneWay}" Padding="14,8">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconRefresh}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,8,0" />
                            <TextBlock Text="KIỂM TRA CẬP NHẬT" FontWeight="Bold" FontSize="12" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. KPI Summary Cards -->
        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Card 1: Current Version -->
            <Border Grid.Column="0" Background="{StaticResource BrushCard}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="16,14">
                <StackPanel>
                    <TextBlock Text="PHIÊN BẢN ĐANG SỬ DỤNG" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,6" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding CurrentVersion}" FontSize="20" FontWeight="Black" Foreground="{StaticResource BrushNeonCyan}" Margin="0,0,8,0" />
                        <Border Background="#1A2740" BorderBrush="{StaticResource BrushNeonCyan}" BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                            <TextBlock Text="ĐANG CHẠY" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource BrushNeonCyan}" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Kênh: Stable • 64-bit Windows" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" Margin="0,6,0,0" />
                </StackPanel>
            </Border>

            <!-- Card 2: Latest Stable Version -->
            <Border Grid.Column="2" Background="{StaticResource BrushCard}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="16,14">
                <StackPanel>
                    <TextBlock Text="BẢN STABLE MỚI NHẤT (GITHUB)" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,6" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding LatestVersion}" FontSize="20" FontWeight="Black" Foreground="{StaticResource BrushNeonPurple}" Margin="0,0,8,0" />
                        <Border Background="#2B1538" BorderBrush="{StaticResource BrushNeonPurple}" BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center"
                                Visibility="{Binding IsUpdateAvailable, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="CÓ BẢN MỚI" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource BrushNeonPurple}" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding ReleaseDate, StringFormat='Ngày phát hành: {0}'}" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" Margin="0,6,0,0" />
                </StackPanel>
            </Border>

            <!-- Card 3: Verification & Security Status -->
            <Border Grid.Column="4" Background="{StaticResource BrushCard}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="16,14">
                <StackPanel>
                    <TextBlock Text="TRẠNG THÁI BẢO MẬT &amp; CHỮ KÝ" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,6" />
                    <TextBlock Text="{Binding VerificationStatus}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource BrushNeonGreen}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding VerificationDetail}" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" TextTrimming="CharacterEllipsis" Margin="0,6,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- 3. Content Area: Release Notes & Download Control -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <!-- Left: Release Notes / Changelog -->
            <Border Grid.Column="0" Background="{StaticResource BrushCard}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="NHẬT KÝ THAY ĐỔI &amp; TÍNH NĂNG MỚI (RELEASE NOTES)" FontSize="13" FontWeight="Bold" Foreground="{StaticResource BrushNeonCyan}" />
                        <TextBlock Text="Nội dung chi tiết được đồng bộ trực tiếp từ GitHub Releases" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" Margin="0,2,0,0" />
                    </StackPanel>

                    <!-- Scrollable Release Notes View -->
                    <Border Grid.Row="1" Background="#0C121E" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="6" Padding="14">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <TextBox Text="{Binding ReleaseNotes}" 
                                     Background="Transparent" 
                                     Foreground="{StaticResource BrushTextPrimary}" 
                                     BorderThickness="0" 
                                     IsReadOnly="True" 
                                     TextWrapping="Wrap" 
                                     FontFamily="Consolas, Segoe UI, Roboto" 
                                     FontSize="12.5" />
                        </ScrollViewer>
                    </Border>

                    <!-- Footer link to GitHub -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                        <Button Style="{StaticResource CyberButtonSecondary}" Command="{Binding OpenGitHubReleasesCommand}" Padding="12,6">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconExport}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" />
                                <TextBlock Text="Xem trên GitHub Releases" FontSize="11" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Right: Actions, Progress & Integrity Verification -->
            <Border Grid.Column="2" Background="{StaticResource BrushCard}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Title -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,16">
                        <TextBlock Text="QUY TRÌNH NÂNG CẤP AN TOÀN" FontSize="13" FontWeight="Bold" Foreground="{StaticResource BrushNeonPurple}" />
                        <TextBlock Text="Tải vào thư mục tạm • Xác minh SHA-256 • Yêu cầu xác nhận" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" Margin="0,2,0,0" />
                    </StackPanel>

                    <!-- Package Info Box -->
                    <Border Grid.Row="1" Background="#0E1626" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,16">
                        <StackPanel>
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="Dung lượng gói cài đặt:" FontSize="11.5" Foreground="{StaticResource BrushTextSecondary}" />
                                <TextBlock Text="{Binding PackageSizeFormatted}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" HorizontalAlignment="Right" />
                            </Grid>
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="Kênh cập nhật:" FontSize="11.5" Foreground="{StaticResource BrushTextSecondary}" />
                                <TextBlock Text="{Binding Channel}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource BrushNeonCyan}" HorizontalAlignment="Right" />
                            </Grid>
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="Mã băm SHA-256:" FontSize="11.5" Foreground="{StaticResource BrushTextSecondary}" />
                                <TextBlock Text="Kiểm tra tự động" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource BrushNeonGreen}" HorizontalAlignment="Right" />
                            </Grid>
                            <Grid>
                                <TextBlock Text="Chữ ký manifest ECDSA:" FontSize="11.5" Foreground="{StaticResource BrushTextSecondary}" />
                                <TextBlock Text="Khóa công khai 256-bit" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource BrushNeonPurple}" HorizontalAlignment="Right" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Real-time Status & Download Progress Panel -->
                    <StackPanel Grid.Row="2" VerticalAlignment="Center">
                        <!-- Status text -->
                        <TextBlock Text="{Binding StatusMessage}" 
                                   Foreground="{StaticResource BrushTextPrimary}" 
                                   FontSize="12" 
                                   TextWrapping="Wrap" 
                                   TextAlignment="Center" 
                                   Margin="0,0,0,14" />

                        <!-- Download Progress Bar (visible when downloading or progress > 0) -->
                        <StackPanel Margin="0,0,0,10">
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="{Binding DownloadProgressText}" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" />
                                <TextBlock Text="{Binding DownloadSpeedText}" FontSize="11" Foreground="{StaticResource BrushNeonCyan}" HorizontalAlignment="Right" />
                            </Grid>
                            <ProgressBar Value="{Binding DownloadProgressPercent, Mode=OneWay}" 
                                         Maximum="100" 
                                         Height="8" 
                                         Background="#142136" 
                                         Foreground="{StaticResource BrushNeonCyan}" />
                            <TextBlock Text="{Binding DownloadProgressPercent, StringFormat='{}{0:F0}%'}" 
                                       FontSize="11" 
                                       FontWeight="Bold" 
                                       Foreground="{StaticResource BrushNeonCyan}" 
                                       HorizontalAlignment="Center" 
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Action Buttons -->
                    <StackPanel Grid.Row="3" Margin="0,16,0,0">
                        <!-- Download and Update Button -->
                        <Button Style="{StaticResource CyberButtonPrimary}" 
                                Command="{Binding DownloadUpdateCommand}" 
                                Visibility="{Binding IsReadyToInstall, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                                IsEnabled="{Binding IsUpdateAvailable}"
                                Height="40" Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconUpdate}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="15" Height="15" Stretch="Uniform" Margin="0,0,8,0" />
                                <TextBlock Text="TẢI XUỐNG VÀ CẬP NHẬT" FontWeight="Bold" FontSize="12.5" />
                            </StackPanel>
                        </Button>

                        <!-- Cancel Download Button (Visible only when downloading) -->
                        <Button Style="{StaticResource CyberButtonDanger}" 
                                Command="{Binding CancelDownloadCommand}" 
                                Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVisibilityConverter}}"
                                Height="36" Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconStop}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,8,0" />
                                <TextBlock Text="HỦY TẢI XUỐNG" FontWeight="Bold" FontSize="12" />
                            </StackPanel>
                        </Button>

                        <!-- Install Now Button (Visible only when download & verification succeeded) -->
                        <Button Style="{StaticResource CyberButtonSuccess}" 
                                Command="{Binding InstallUpdateCommand}" 
                                Visibility="{Binding IsReadyToInstall, Converter={StaticResource BoolToVisibilityConverter}}"
                                Height="42" Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconPlay}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="15" Height="15" Stretch="Uniform" Margin="0,0,8,0" />
                                <TextBlock Text="CÀI ĐẶT NGAY (XÁC NHẬN)" FontWeight="Black" FontSize="13" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
