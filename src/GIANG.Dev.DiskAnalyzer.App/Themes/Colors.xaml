<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Cyberpunk Dark Neon Palette -->
    <Color x:Key="ColorBgDark">#0B0F19</Color>
    <Color x:Key="ColorBgSidebar">#080C14</Color>
    <Color x:Key="ColorPanel">#111827</Color>
    <Color x:Key="ColorCard">#162032</Color>
    <Color x:Key="ColorCardHover">#1E293B</Color>
    <Color x:Key="ColorBorder">#1E293B</Color>
    <Color x:Key="ColorBorderBright">#334155</Color>

    <!-- Neon Accents -->
    <Color x:Key="ColorNeonCyan">#00F0FF</Color>
    <Color x:Key="ColorNeonCyanGlow">#3300F0FF</Color>
    <Color x:Key="ColorNeonPurple">#A855F7</Color>
    <Color x:Key="ColorNeonPurpleGlow">#33A855F7</Color>
    <Color x:Key="ColorNeonGreen">#10B981</Color>
    <Color x:Key="ColorNeonAmber">#F59E0B</Color>
    <Color x:Key="ColorNeonRed">#EF4444</Color>
    <Color x:Key="ColorNeonRedGlow">#33EF4444</Color>

    <!-- Text Colors -->
    <Color x:Key="ColorTextPrimary">#F8FAFC</Color>
    <Color x:Key="ColorTextSecondary">#94A3B8</Color>
    <Color x:Key="ColorTextMuted">#64748B</Color>

    <!-- Solid Brushes -->
    <SolidColorBrush x:Key="BrushBgDark" Color="{StaticResource ColorBgDark}" />
    <SolidColorBrush x:Key="BrushBgSidebar" Color="{StaticResource ColorBgSidebar}" />
    <SolidColorBrush x:Key="BrushPanel" Color="{StaticResource ColorPanel}" />
    <SolidColorBrush x:Key="BrushCard" Color="{StaticResource ColorCard}" />
    <SolidColorBrush x:Key="BrushCardHover" Color="{StaticResource ColorCardHover}" />
    <SolidColorBrush x:Key="BrushBorder" Color="{StaticResource ColorBorder}" />
    <SolidColorBrush x:Key="BrushBorderBright" Color="{StaticResource ColorBorderBright}" />

    <SolidColorBrush x:Key="BrushNeonCyan" Color="{StaticResource ColorNeonCyan}" />
    <SolidColorBrush x:Key="BrushNeonCyanGlow" Color="{StaticResource ColorNeonCyanGlow}" />
    <SolidColorBrush x:Key="BrushNeonPurple" Color="{StaticResource ColorNeonPurple}" />
    <SolidColorBrush x:Key="BrushNeonPurpleGlow" Color="{StaticResource ColorNeonPurpleGlow}" />
    <SolidColorBrush x:Key="BrushNeonGreen" Color="{StaticResource ColorNeonGreen}" />
    <SolidColorBrush x:Key="BrushNeonAmber" Color="{StaticResource ColorNeonAmber}" />
    <SolidColorBrush x:Key="BrushNeonRed" Color="{StaticResource ColorNeonRed}" />
    <SolidColorBrush x:Key="BrushNeonRedGlow" Color="{StaticResource ColorNeonRedGlow}" />

    <SolidColorBrush x:Key="BrushTextPrimary" Color="{StaticResource ColorTextPrimary}" />
    <SolidColorBrush x:Key="BrushTextSecondary" Color="{StaticResource ColorTextSecondary}" />
    <SolidColorBrush x:Key="BrushTextMuted" Color="{StaticResource ColorTextMuted}" />

    <!-- Gradient Accents -->
    <LinearGradientBrush x:Key="BrushNeonGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#00F0FF" Offset="0" />
        <GradientStop Color="#A855F7" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BrushCyberGlow" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#00F0FF" Offset="0" />
        <GradientStop Color="#10B981" Offset="1" />
    </LinearGradientBrush>

</ResourceDictionary>
